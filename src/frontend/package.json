{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "webmcp:smoke": "webmcp-evals smoke -u http://localhost:3000/create -e webmcp-evals/evals.json -v",
    "webmcp:local": "webmcp-evals local -t webmcp-evals/schema.json -e webmcp-evals/evals.json",
    "webmcp:schema-check": "node -e \"const s=require('./webmcp-evals/schema.json'); const n=s.tools.map(t=>t.name).join(','); if(n!=='list_projects,create_project,open_project') process.exit(1); console.log('ok',n)\"",
    "webmcp:browser": "webmcp-evals browser -u http://localhost:3000/create -e webmcp-evals/evals.json --chrome-channel chrome"
  },
  "dependencies": {
    "next": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-zoom-pan-pinch": "^4.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest",
    "webmcp-evals": "^0.0.4"
  }
}
