{
  "tools": [
    {
      "name": "list_projects",
      "description": "List the user's recent YADL projects (id, name, type, template).",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "create_project",
      "description": "Create a labeling project. type is boxes, polygons, or keypoints. For keypoints, pass template hand|pose|face (default hand). Does not upload media — returns studio_url; a human adds files in the product UI.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Project name" },
          "type": {
            "type": "string",
            "enum": ["boxes", "polygons", "keypoints"],
            "description": "Annotation type"
          },
          "template": {
            "type": "string",
            "enum": ["hand", "pose", "face"],
            "description": "Keypoint skeleton when type=keypoints"
          }
        },
        "required": ["name", "type"],
        "oneOf": [
          {
            "properties": { "type": { "enum": ["boxes", "polygons"] } },
            "not": { "required": ["template"] }
          },
          { "properties": { "type": { "const": "keypoints" } } }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "open_project",
      "description": "Open a project studio by id or exact name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        },
        "oneOf": [
          { "required": ["id"] },
          { "required": ["name"] }
        ],
        "additionalProperties": false
      }
    }
  ]
}
