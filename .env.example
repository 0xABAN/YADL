# Backend (local uvicorn + Railway)
DATABASE_URL=postgres://user:pass@host:5432/yadl
S3_BUCKET=yadl
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=…
# AWS_SECRET_ACCESS_KEY=…
SESSION_SECRET=change-me
# Local frontend origin. On Railway set to the Vercel URL (https://….vercel.app).
APP_ORIGIN=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth callbacks (add both in the GitHub OAuth app):
#   http://localhost:3000/api/auth/github/callback
#   https://<your-vercel-app>/api/auth/github/callback
# S3_ENDPOINT=http://127.0.0.1:9000

# Frontend (Vercel build env only — rewrites bake this in at next build)
# Leave unset locally → http://127.0.0.1:8000
# BACKEND_URL=https://<your-railway-app>.up.railway.app

# Prod guard: Railway sets RAILWAY_ENVIRONMENT automatically.
# Or set ENV=production to require a real SESSION_SECRET.
